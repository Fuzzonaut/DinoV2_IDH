    0.739447        0.914229  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["Average precision: 0.5447; observed test mutant fraction: 21.3%\n","Test prevalence is a descriptive PR reference; it was not used to fit the baseline.\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>bin_lower</th>\n","      <th>bin_upper</th>\n","      <th>patients</th>\n","      <th>mutants</th>\n","      <th>mean_score</th>\n","      <th>observed_mutant_fraction</th>\n","      <th>Wilson_95_low</th>\n","      <th>Wilson_95_high</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>0.0</td>\n","      <td>0.2</td>\n","      <td>53</td>\n","      <td>5</td>\n","      <td>0.050942</td>\n","      <td>0.094340</td>\n","      <td>0.040973</td>\n","      <td>0.202537</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>0.2</td>\n","      <td>0.4</td>\n","      <td>5</td>\n","      <td>4</td>\n","      <td>0.290115</td>\n","      <td>0.800000</td>\n","      <td>0.375535</td>\n","      <td>0.963776</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>0.4</td>\n","      <td>0.6</td>\n","      <td>7</td>\n","      <td>1</td>\n","      <td>0.463029</td>\n","      <td>0.142857</td>\n","      <td>0.025680</td>\n","      <td>0.513128</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","      <td>0.6</td>\n","      <td>0.8</td>\n","      <td>2</td>\n","      <td>1</td>\n","      <td>0.725604</td>\n","      <td>0.500000</td>\n","      <td>0.094531</td>\n","      <td>0.905469</td>\n","    <